stackql
.stackql/
ref/
uat-results.log


# local credentials - never commit
.env

# node
node_modules/

# stackql runtime artifacts
stackql.exe
stackql-server.log

# the upstream azure-sdk-for-python root .gitignore excludes any `website/`
# dir - re-include ours (build artifacts are excluded by website/.gitignore)
!website/

# same problem for `bin/` (upstream ignores it as build output) - ours holds
# the committed build wrappers and test harnesses
!bin/

# website build artifacts
website/*/build/
website/*/.docusaurus/

# python
.venv/
__pycache__/
*.pyc
